# ResearchForge backend environment
# Copy to backend/.env and fill in the values:
#   cp backend/.env.example backend/.env

# --- Required ---

# Used by every agent that calls GPT-4o (Document, FactCheck, Outline, Synthesis)
OPENAI_API_KEY=

# Used by the Research agent for live web search
TAVILY_API_KEY=

# Postgres DSN — persists sessions and LangGraph checkpoints.
# Matches the docker-compose.yml Postgres.
DATABASE_URL=postgresql://researchforge:researchforge@localhost:5432/researchforge

# Comma-separated list of allowed frontend origins (or * for development only)
CORS_ORIGINS=http://localhost:3000

# --- Authentication ---

# API key required on every route except /api/health. Fail closed when unset.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
RESEARCHFORGE_API_KEY=

# --- Cost controls (optional) ---

# Global cap on concurrent graph executions; requests are rejected with 429
# when the limit is reached.
MAX_CONCURRENT_RUNS=3

# Maximum total tokens (prompt + completion) per graph-execution phase.
# Leave empty for no limit.
RUN_TOKEN_BUDGET=

# Maximum total tokens (prompt + completion) per chat turn on a completed
# report (chat-with-report). Leave empty for no limit.
CHAT_TOKEN_BUDGET=

# --- Deep-research loop (optional) ---

# Hard cap on gap-driven re-research rounds after outline approval — makes
# research↔synthesis ping-pong impossible. Values below 1 fall back to the
# default of 2.
MAX_RESEARCH_ROUNDS=2

# Maximum total tokens (prompt + completion) per gap-tripped research round:
# a fresh sub-cap on top of RUN_TOKEN_BUDGET, released when the round ends.
# Leave empty for no limit (the run budget remains the only ceiling).
RESEARCH_ROUND_TOKEN_BUDGET=

# Overall report confidence below this (0.0–1.0) trips a re-research round.
# Default: 0.6.
RESEARCH_GAP_CONFIDENCE_THRESHOLD=0.6

# Share of UNSUPPORTED fact-check verdicts above this (0.0–1.0) trips a
# re-research round. Default: 0.3.
RESEARCH_GAP_UNSUPPORTED_RATE=0.3

# --- Scholarly sources (optional — all three work without them) ---

# Semantic Scholar free API key; without it requests are unauthenticated
# and share the public rate-limited pool (research still works).
SEMANTIC_SCHOLAR_API_KEY=

# Contact email for Crossref's polite pool (faster, more reliable access).
CROSSREF_CONTACT_EMAIL=

# --- LangSmith tracing (optional) ---

LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ResearchForge
# Override only for a self-hosted LangSmith instance
LANGCHAIN_ENDPOINT=
