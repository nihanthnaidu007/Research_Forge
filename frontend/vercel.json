{
  "buildCommand": "yarn build",
  "outputDirectory": "build",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://researchforge-backend.up.railway.app/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Forwarded-Host", "value": "$host" }
      ]
    }
  ]
}
